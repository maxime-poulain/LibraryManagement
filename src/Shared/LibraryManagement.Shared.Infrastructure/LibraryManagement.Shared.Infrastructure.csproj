<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>LibraryManagement.Shared.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Mediator.Abstractions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <!-- Relational, not a provider: the outbox mapping names a table and a filtered index,
             which are relational concepts. Which database serves them stays the host's decision. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <!-- Logging proper for AddLogging, so a logger always resolves and the host only adds
             sinks; the abstractions are referenced directly as well because the LoggerMessage
             source generator ships in that package and generators do not flow transitively. -->
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LibraryManagement.Shared.Application\LibraryManagement.Shared.Application.csproj" />
    </ItemGroup>

</Project>
