<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>LibraryManagement.Holdings.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Relational, not a provider. The module's mapping is tables and schemas; which database
             serves them is the host's decision, made once at startup. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <!-- Registering the module's validators is part of registering the module. -->
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\LibraryManagement.Shared.Infrastructure\LibraryManagement.Shared.Infrastructure.csproj" />
        <ProjectReference Include="..\LibraryManagement.Holdings.Application\LibraryManagement.Holdings.Application.csproj" />
        <!-- The module answers its own published language. -->
        <ProjectReference Include="..\LibraryManagement.Holdings.PublishedLanguage\LibraryManagement.Holdings.PublishedLanguage.csproj" />
        <!-- And listens to one fact of Circulation's: a copy nobody returned. A published language
             and nothing else — it references nothing itself, so this buys no dependency on
             Circulation's model, which is the whole reason the contract is flat. -->
        <ProjectReference Include="..\..\Circulation\LibraryManagement.Circulation.PublishedLanguage\LibraryManagement.Circulation.PublishedLanguage.csproj" />
    </ItemGroup>

</Project>
