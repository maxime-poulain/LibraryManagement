<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>LibraryManagement.Catalog.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Relational, not a provider. The module's mapping is tables and schemas; which database
             serves them is the host's decision, made once at startup. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <!-- Registering the module's validators is part of registering the module. -->
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Shared\LibraryManagement.Shared.Infrastructure\LibraryManagement.Shared.Infrastructure.csproj" />
        <ProjectReference Include="..\LibraryManagement.Catalog.Application\LibraryManagement.Catalog.Application.csproj" />
        <!-- The module answers its own published language: the interface is declared there, the
             implementation reads this module's store. -->
        <ProjectReference Include="..\LibraryManagement.Catalog.PublishedLanguage\LibraryManagement.Catalog.PublishedLanguage.csproj" />
    </ItemGroup>

</Project>
