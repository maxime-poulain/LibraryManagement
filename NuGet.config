<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    `clear` drops every source inherited from the machine or user configuration,
    so restoring this repository consults exactly the feeds declared here and
    nothing else. Without it a private feed configured on a contributor's
    machine could serve a package under a name we expect to come from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
