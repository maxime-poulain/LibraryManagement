<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Mediator.Abstractions" Version="3.1.0-rc.1" />
        <PackageVersion Include="Mediator.SourceGenerator" Version="3.1.0-rc.1" />
        <PackageVersion Include="FluentValidation" Version="12.1.1" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="coverlet.collector" Version="10.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <!-- Integration tests run against the engine the modules actually target. A different one
             would prove the mapping works somewhere the system will never run: schemas and
             rowversion are exactly what the module boundary and optimistic concurrency rest on,
             and they are exactly what a stand-in engine does not have. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
        <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
        <!-- The outbox drain's scheduler. Referenced by the composition root alone — today the
             composition tests, the host later. No module names a scheduler, exactly as none names
             a database provider: the processor is a plain class, and what triggers it is the
             host's decision. -->
        <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
        <PackageVersion Include="Hangfire.SqlServer" Version="1.8.24" />
        <PackageVersion Include="Hangfire.NetCore" Version="1.8.24" />
        <!-- Not referenced directly by anything. Hangfire depends on 11.0.1, which NuGet audit
             flags (GHSA-5crp-9r3c-p9vr); transitive pinning lifts it to a patched version. -->
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup Label="Analyzers applied to every project">
        <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
        <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.30.0.144632" />
    </ItemGroup>

</Project>
