<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- xUnit v3 runs on Microsoft.Testing.Platform: a test project is a standalone executable. -->
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <RootNamespace>LibraryManagement.Composition.Tests</RootNamespace>
        <!-- MSG0005: message without any registered handler.
             It fires on every domain event, and it is wrong to do so. An event announces that
             something happened; the aggregate that raised it does not know or care who listens, and
             nobody listening is a legitimate state rather than a missing registration. The rule is
             right about commands and queries, which the generator reports through MSG0004 and
             MSG0001 instead — those stay on. -->
        <NoWarn>$(NoWarn);MSG0005</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Testcontainers.MsSql" />
        <!-- The source generator lives here and nowhere else. It insists on a coherent set of
             handlers — one per message, one for every message — and what it registers it resolves:
             the first Send builds every handler the container knows about. Both are true of a
             composition root and false of the architecture tests, whose fixtures are handlers
             written to be wrong on purpose and never meant to run. -->
        <PackageReference Include="Mediator.SourceGenerator" />
    </ItemGroup>

    <ItemGroup>
        <!-- The provider, through the same extensions the host uses: a composition root chooses the
             engine, the modules never name one, and the migrations projects are where that choice
             is spelled — so these tests build their schemas exactly as a deployment does. -->
        <ProjectReference Include="..\..\..\src\Host\LibraryManagement.Catalog.Migrations.SqlServer\LibraryManagement.Catalog.Migrations.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Host\LibraryManagement.Charges.Migrations.SqlServer\LibraryManagement.Charges.Migrations.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Host\LibraryManagement.Circulation.Migrations.SqlServer\LibraryManagement.Circulation.Migrations.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Host\LibraryManagement.Holdings.Migrations.SqlServer\LibraryManagement.Holdings.Migrations.SqlServer.csproj" />
        <ProjectReference Include="..\..\..\src\Host\LibraryManagement.Members.Migrations.SqlServer\LibraryManagement.Members.Migrations.SqlServer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Catalog\LibraryManagement.Catalog.Infrastructure\LibraryManagement.Catalog.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\src\Charges\LibraryManagement.Charges.Infrastructure\LibraryManagement.Charges.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\src\Circulation\LibraryManagement.Circulation.Infrastructure\LibraryManagement.Circulation.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\src\Holdings\LibraryManagement.Holdings.Infrastructure\LibraryManagement.Holdings.Infrastructure.csproj" />
        <ProjectReference Include="..\..\..\src\Members\LibraryManagement.Members.Infrastructure\LibraryManagement.Members.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Shouldly" />
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
